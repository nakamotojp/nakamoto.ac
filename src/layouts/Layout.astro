---
import { CATEGORY_META_LIST } from '../utils/categories';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'NAKAMOTO | 活動報告・報道歴アーカイブ',
  description = '中本慧思・中本怜祐・中本賢吾の報道歴、コンテスト受賞、起業活動などの実績アーカイブ。',
} = Astro.props;
---

<!doctype html>
<html lang="ja" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://nakamoto.ac" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Noto+Sans+JP:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col antialiased selection:bg-blue-600 selection:text-white">
    <!-- Header -->
    <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-200">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/" class="group flex items-center gap-2.5">
          <span class="font-display text-2xl sm:text-3xl tracking-wider text-slate-900 group-hover:text-blue-600 transition-colors">
            NAKAMOTO
          </span>
          <span class="hidden sm:inline-block px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-slate-500 bg-slate-100 rounded border border-slate-200">
            Archive
          </span>
        </a>

        <nav class="flex items-center gap-1 sm:gap-4 text-xs sm:text-sm font-medium">
          <a
            href="/"
            class="px-2.5 py-1.5 rounded-lg text-slate-700 hover:text-slate-900 hover:bg-slate-100 transition-colors"
          >
            最新一覧
          </a>
          <a
            href="/#persons"
            class="px-2.5 py-1.5 rounded-lg text-slate-700 hover:text-slate-900 hover:bg-slate-100 transition-colors"
          >
            人物別
          </a>
          <div class="relative group">
            <button
              class="px-2.5 py-1.5 rounded-lg text-slate-700 hover:text-slate-900 hover:bg-slate-100 transition-colors inline-flex items-center gap-1"
            >
              <span>カテゴリ</span>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5 text-slate-400 group-hover:text-slate-600">
                <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
              </svg>
            </button>
            <div class="absolute right-0 top-full mt-1 hidden group-hover:block w-44 py-2 bg-white rounded-xl shadow-lg border border-slate-200 text-xs">
              {
                CATEGORY_META_LIST.map((c) => (
                  <a
                    href={`/category/${c.slug}`}
                    class="flex items-center gap-2 px-3 py-2 text-slate-700 hover:bg-slate-50 hover:text-blue-600 transition-colors"
                  >
                    <span>{c.icon}</span>
                    <span>{c.name}</span>
                  </a>
                ))
              }
            </div>
          </div>
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-12">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="mt-auto border-t border-slate-200 bg-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
        <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-4 text-center sm:text-left">
          <span class="font-display text-lg tracking-wider text-slate-800">NAKAMOTO</span>
          <span class="hidden sm:inline text-slate-300">|</span>
          <p>報道歴・実績アーカイブ (Markdown管理)</p>
        </div>
        <div class="flex items-center gap-4">
          <a
            href="https://github.com/nakamotojp/nakamoto.ac"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-slate-900 transition-colors inline-flex items-center gap-1"
          >
            <span>GitHub</span>
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
          </a>
          <span>© {new Date().getFullYear()} nakamoto.ac</span>
        </div>
      </div>
    </footer>
  </body>
</html>

