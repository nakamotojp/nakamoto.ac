---
import { getCategoryMeta } from '../utils/categories';

interface Props {
  category: string;
  size?: 'sm' | 'md' | 'lg';
  linkable?: boolean;
}

const { category, size = 'md', linkable = false } = Astro.props;
const meta = getCategoryMeta(category);

const sizeClasses = {
  sm: 'px-2 py-0.5 text-xs gap-1',
  md: 'px-2.5 py-1 text-xs sm:text-sm gap-1.5',
  lg: 'px-3 py-1.5 text-sm gap-2',
}[size];
---

{
  linkable ? (
    <a
      href={`/category/${meta.slug}`}
      class={`inline-flex items-center font-medium rounded-full border transition-colors hover:opacity-90 ${meta.badgeClass} ${sizeClasses}`}
    >
      <span class="text-xs leading-none">{meta.icon}</span>
      <span>{meta.name}</span>
    </a>
  ) : (
    <span
      class={`inline-flex items-center font-medium rounded-full border transition-colors ${meta.badgeClass} ${sizeClasses}`}
    >
      <span class="text-xs leading-none">{meta.icon}</span>
      <span>{meta.name}</span>
    </span>
  )
}

