---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ReportCard from '../../components/ReportCard.astro';
import { CATEGORY_META_LIST, getCategoryMeta } from '../../utils/categories';

export async function getStaticPaths() {
  const paths = [];

  // Generate paths for both slug (e.g. 'press') and Japanese name (e.g. '新聞雑誌')
  for (const meta of CATEGORY_META_LIST) {
    paths.push({
      params: { category: meta.slug },
      props: { categoryName: meta.name },
    });
    paths.push({
      params: { category: meta.name },
      props: { categoryName: meta.name },
    });
  }

  return paths;
}

interface Props {
  categoryName: string;
}

const { categoryName } = Astro.props;
const currentMeta = getCategoryMeta(categoryName);

// Fetch all reports matching this category
const allReports = await getCollection('reports');
const filteredReports = allReports
  .filter((r) => r.data.category === currentMeta.name)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Fetch persons for lookup
const allPersons = await getCollection('persons');
const personsMap = new Map(allPersons.map((p) => [p.slug, p.data]));
---

<Layout
  title={`${currentMeta.name}の実績・報道一覧 | NAKAMOTO ARCHIVE`}
  description={currentMeta.description}
>
  <!-- Breadcrumbs -->
  <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6">
    <a href="/" class="hover:text-slate-900 transition-colors">トップ</a>
    <span>/</span>
    <span class="text-slate-500">カテゴリ</span>
    <span>/</span>
    <span class="text-slate-800 font-medium">{currentMeta.name}</span>
  </nav>

  <!-- Category Header -->
  <header class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-sm mb-8">
    <div class="flex items-center gap-3 mb-2">
      <span class="text-3xl">{currentMeta.icon}</span>
      <h1 class="text-2xl sm:text-3xl font-bold text-slate-900">
        {currentMeta.name}
      </h1>
      <span class="ml-2 px-2.5 py-0.5 text-xs font-semibold rounded-full bg-slate-100 text-slate-700 font-mono">
        {filteredReports.length} 件
      </span>
    </div>
    <p class="text-xs sm:text-sm text-slate-600 mt-2">
      {currentMeta.description}
    </p>

    <!-- Category quick switcher -->
    <div class="mt-6 pt-4 border-t border-slate-100 flex flex-wrap items-center gap-1.5 sm:gap-2">
      <span class="text-xs font-semibold text-slate-400 mr-2">他のカテゴリ:</span>
      {
        CATEGORY_META_LIST.map((meta) => {
          const isCurrent = meta.name === currentMeta.name;
          return (
            <a
              href={`/category/${meta.slug}`}
              class={`inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-medium border transition-colors ${
                isCurrent
                  ? 'bg-slate-900 text-white border-slate-900 shadow-sm'
                  : 'bg-slate-50 text-slate-700 border-slate-200 hover:bg-slate-100'
              }`}
            >
              <span>{meta.icon}</span>
              <span>{meta.name}</span>
            </a>
          );
        })
      }
    </div>
  </header>

  <!-- Reports List -->
  <section class="space-y-4">
    {filteredReports.length === 0 ? (
      <div class="py-16 text-center bg-white border border-slate-200 rounded-xl">
        <p class="text-slate-400 text-sm">現在登録されている実績はありません。</p>
      </div>
    ) : (
      filteredReports.map((report) => {
        const person = personsMap.get(report.data.personId);
        return (
          <ReportCard
            title={report.data.title}
            date={report.data.date}
            category={report.data.category}
            personId={report.data.personId}
            personName={person?.name}
            url={report.data.url}
            description={report.data.description}
            image={report.data.image}
          />
        );
      })
    )}
  </section>
</Layout>
