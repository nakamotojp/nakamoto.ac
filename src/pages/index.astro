---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ReportCard from '../components/ReportCard.astro';
import { CATEGORIES, type Category } from '../content/config';
import { CATEGORY_META_LIST } from '../utils/categories';
import { resolveReportImages } from '../utils/reportImage';

// Fetch all reports and sort by date descending
const allReports = await resolveReportImages(await getCollection('reports'));
const sortedReports = allReports.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

// Fetch all persons and create lookup map
const allPersons = await getCollection('persons');
const personsSorted = allPersons.sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
const personsMap = new Map(allPersons.map((p) => [p.slug, p.data]));

// Category counts
const categoryCounts = CATEGORIES.reduce((acc, cat) => {
  acc[cat] = sortedReports.filter((r) => r.data.category === cat).length;
  return acc;
}, {} as Record<Category, number>);

const totalCount = sortedReports.length;
---

<Layout>
  <!-- Hero Section -->
  <section class="text-center py-6 sm:py-10 border-b border-slate-200 mb-8 sm:mb-12">
    <h1 class="font-display text-4xl sm:text-6xl text-slate-900 tracking-wider mb-3">
      NAKAMOTO ARCHIVE
    </h1>
    <p class="text-sm sm:text-base text-slate-600 max-w-2xl mx-auto leading-relaxed">
      中本慧思・中本怜祐・中本賢吾の報道歴、メディア出演、コンテスト受賞、起業活動等の公式記録・アーカイブです。
    </p>

    <!-- Persons Quick Grid -->
    <div id="persons" class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4 max-w-3xl mx-auto text-left">
      {
        personsSorted.map((person) => {
          const reportCount = sortedReports.filter(
            (r) => r.data.personId === person.slug
          ).length;
          return (
            <a
              href={`/person/${person.slug}`}
              class="group block p-4 bg-white border border-slate-200 hover:border-slate-400 rounded-xl transition-all duration-200 hover:shadow-md"
            >
              <div class="text-xs font-semibold tracking-wider text-slate-400 group-hover:text-blue-600 transition-colors uppercase font-display">
                {person.data.nameEn || person.slug}
              </div>
              <div class="mt-1 text-base sm:text-lg font-bold text-slate-900">
                {person.data.name}
              </div>
              <div class="mt-1 text-xs text-slate-500 line-clamp-1">
                {person.data.role}
              </div>
              <div class="mt-3 flex items-center justify-between text-xs text-slate-400 pt-2 border-t border-slate-100">
                <span>実績・報道 {reportCount} 件</span>
                <span class="text-blue-600 font-semibold group-hover:translate-x-0.5 transition-transform">→</span>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>

  <!-- Filter & Reports Section -->
  <section id="reports-section">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 flex items-center gap-2">
          <span>報道・活動歴一覧</span>
          <span id="visible-count-badge" class="text-xs font-semibold px-2.5 py-0.5 bg-slate-200 text-slate-700 rounded-full font-mono">
            {totalCount}
          </span>
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
          最新の発表・掲載実績順に表示しています
        </p>
      </div>

      <!-- Filter Buttons (Client-side interactive) -->
      <div class="flex flex-wrap items-center gap-1.5 sm:gap-2" id="category-filter-buttons">
        <button
          type="button"
          data-filter="all"
          class="filter-btn active inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold border transition-all duration-150 bg-slate-900 text-white border-slate-900 shadow-sm"
        >
          <span>すべて</span>
          <span class="text-[11px] opacity-80 font-mono">({totalCount})</span>
        </button>

        {
          CATEGORY_META_LIST.map((meta) => {
            const count = categoryCounts[meta.name] || 0;
            return (
              <button
                type="button"
                data-filter={meta.name}
                class="filter-btn inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-medium border border-slate-200 bg-white text-slate-700 hover:bg-slate-100 transition-all duration-150"
              >
                <span>{meta.icon}</span>
                <span>{meta.name}</span>
                <span class="text-[11px] text-slate-400 font-mono">({count})</span>
              </button>
            );
          })
        }
      </div>
    </div>

    <!-- Reports Grid / List -->
    <div id="reports-list" class="space-y-4 grid-responsive">
      {
        sortedReports.map((report) => {
          const person = personsMap.get(report.data.personId);
          return (
            <ReportCard
              title={report.data.title}
              date={report.data.date}
              category={report.data.category}
              personId={report.data.personId}
              personName={person?.name}
              url={report.data.url}
              description={report.data.description}
              image={report.data.image}
            />
          );
        })
      }
    </div>

    <!-- Empty state message -->
    <div
      id="empty-state"
      class="hidden py-16 text-center bg-white border border-slate-200 rounded-xl"
    >
      <p class="text-slate-400 text-sm">該当する実績・報道がありません。</p>
    </div>
  </section>

  <!-- Interactive Filter Script -->
  <script>
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const reportCards = document.querySelectorAll<HTMLElement>('.report-card');
    const visibleCountBadge = document.getElementById('visible-count-badge');
    const emptyState = document.getElementById('empty-state');

    function applyFilter(category: string) {
      let visibleCount = 0;

      reportCards.forEach((card) => {
        const cardCategory = card.getAttribute('data-category');
        if (category === 'all' || cardCategory === category) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (visibleCountBadge) {
        visibleCountBadge.textContent = String(visibleCount);
      }

      if (emptyState) {
        emptyState.classList.toggle('hidden', visibleCount > 0);
      }

      // Update button styles
      filterButtons.forEach((btn) => {
        const btnFilter = btn.getAttribute('data-filter');
        const isActive = btnFilter === category;
        if (isActive) {
          btn.classList.add('bg-slate-900', 'text-white', 'border-slate-900', 'shadow-sm');
          btn.classList.remove('bg-white', 'text-slate-700', 'border-slate-200');
        } else {
          btn.classList.remove('bg-slate-900', 'text-white', 'border-slate-900', 'shadow-sm');
          btn.classList.add('bg-white', 'text-slate-700', 'border-slate-200');
        }
      });
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter') || 'all';
        applyFilter(filter);
      });
    });
  </script>
</Layout>
