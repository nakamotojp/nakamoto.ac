---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ReportCard from '../../components/ReportCard.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';

export async function getStaticPaths() {
  const persons = await getCollection('persons');
  return persons.map((person) => ({
    params: { id: person.slug },
    props: { person },
  }));
}

const { person } = Astro.props;
const { Content } = await person.render();

// Fetch reports for this person
const allReports = await getCollection('reports');
const personReports = allReports
  .filter((r) => r.data.personId === person.slug)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Group reports by year
const reportsByYear = personReports.reduce((acc, report) => {
  const year = report.data.date.getFullYear().toString();
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(report);
  return acc;
}, {} as Record<string, typeof personReports>);

const sortedYears = Object.keys(reportsByYear).sort((a, b) => Number(b) - Number(a));

// Category breakdown for this person
const categoryCounts = personReports.reduce((acc, r) => {
  acc[r.data.category] = (acc[r.data.category] || 0) + 1;
  return acc;
}, {} as Record<string, number>);
---

<Layout
  title={`${person.data.name} (${person.data.nameEn || ''}) | 報道歴・実績`}
  description={person.data.bio || `${person.data.name}の報道歴・活動実績アーカイブ。`}
>
  <!-- Breadcrumbs -->
  <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6">
    <a href="/" class="hover:text-slate-900 transition-colors">トップ</a>
    <span>/</span>
    <a href="/#persons" class="hover:text-slate-900 transition-colors">人物一覧</a>
    <span>/</span>
    <span class="text-slate-800 font-medium">{person.data.name}</span>
  </nav>

  <!-- Profile Header Card -->
  <header class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-sm mb-10">
    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-6">
      <div>
        <span class="font-display text-base tracking-widest text-blue-600 uppercase font-semibold">
          {person.data.nameEn || person.slug}
        </span>
        <h1 class="text-2xl sm:text-4xl font-bold text-slate-900 mt-1">
          {person.data.name}
        </h1>
        {person.data.role && (
          <p class="text-sm sm:text-base font-medium text-slate-600 mt-1.5">
            {person.data.role}
          </p>
        )}
      </div>

      {person.data.website && (
        <a
          href={person.data.website}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-slate-900 text-white hover:bg-blue-600 transition-colors self-start shadow-sm"
        >
          <span>公式サイト・関連リンク</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
            <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd" />
          </svg>
        </a>
      )}
    </div>

    {person.data.bio && (
      <p class="mt-4 text-sm text-slate-600 leading-relaxed max-w-3xl pt-4 border-t border-slate-100">
        {person.data.bio}
      </p>
    )}

    <div class="mt-4 pt-3 border-t border-slate-100 text-xs sm:text-sm text-slate-600 leading-relaxed max-w-3xl [&_h3]:font-bold [&_h3]:text-slate-800 [&_h3]:text-xs [&_h3]:uppercase [&_h3]:tracking-wider [&_h3]:mb-2 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:space-y-1.5 [&_a]:text-blue-600 [&_a]:underline hover:[&_a]:text-blue-800">
      <Content />
    </div>

    <!-- Category Pills Summary -->
    <div class="mt-6 pt-4 border-t border-slate-100 flex flex-wrap items-center gap-2">
      <span class="text-xs font-semibold text-slate-400 mr-1">実績カテゴリ:</span>
      {
        Object.entries(categoryCounts).map(([cat, count]) => (
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs bg-slate-100 text-slate-700">
            <CategoryBadge category={cat} size="sm" />
            <span class="font-mono font-semibold text-slate-500">({count})</span>
          </span>
        ))
      }
      <span class="ml-auto text-xs font-semibold text-slate-500 font-mono">
        全 {personReports.length} 件
      </span>
    </div>
  </header>

  <!-- Timeline by Year -->
  <section>
    <div class="flex items-center justify-between mb-8 pb-3 border-b border-slate-200">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900">
          年次別 報道・活動タイムライン
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
          年代順に整理された活動実績の記録です
        </p>
      </div>
    </div>

    {personReports.length === 0 ? (
      <div class="py-16 text-center bg-white border border-slate-200 rounded-xl">
        <p class="text-slate-400 text-sm">現在登録されている実績はありません。</p>
        <p class="text-xs text-slate-400 mt-1">
          <code>src/content/reports/</code> にMarkdownを追加すると自動で表示されます。
        </p>
      </div>
    ) : (
      <div class="space-y-12">
        {sortedYears.map((year) => {
          const reports = reportsByYear[year];
          return (
            <div class="relative pl-6 sm:pl-10 border-l-2 border-slate-200">
              <!-- Year Node Marker -->
              <div class="absolute -left-[11px] top-0 flex items-center justify-center w-5 h-5 rounded-full bg-blue-600 ring-4 ring-slate-50">
                <div class="w-1.5 h-1.5 rounded-full bg-white"></div>
              </div>

              <!-- Year Header -->
              <div class="flex items-center gap-3 mb-5">
                <span class="font-display text-2xl sm:text-3xl font-bold tracking-wider text-slate-900">
                  {year}年
                </span>
                <span class="px-2 py-0.5 text-xs font-semibold rounded-full bg-slate-200 text-slate-700 font-mono">
                  {reports.length} 件
                </span>
              </div>

              <!-- Reports List for this Year -->
              <div class="space-y-4">
                {reports.map((report) => (
                  <ReportCard
                    title={report.data.title}
                    date={report.data.date}
                    category={report.data.category}
                    personId={report.data.personId}
                    url={report.data.url}
                    description={report.data.description}
                    image={report.data.image}
                  />
                ))}
              </div>
            </div>
          );
        })}
      </div>
    )}
  </section>
</Layout>
